# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ── Virtual environments ───────────────────────────────────────────────
venv/
.venv/
env/

# ── Test / coverage tooling ────────────────────────────────────────────
.pytest_cache/

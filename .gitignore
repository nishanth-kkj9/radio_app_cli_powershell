# Ignore everything
*

# Keep gitignore
!.gitignore

# Keep project folders
!radio_ps/
!radio_ps/**
!.github/
!.github/**
!CHANGELOG.md
!CONTRIBUTING.md
!LICENSE
!README.md

# Ignore Python cache
radio_ps/**/__pycache__/
radio_ps/**/src/**/__pycache__/
radio_ps/**/*.pyc

# Ignore build artifacts
radio_ps/src/*.egg-info/
*.egg-info/
radio_ps/build/
radio_ps/dist/

# Ignore test/tooling caches
.pytest_cache/
radio_ps/.pytest_cache/

# Ignore virtual environment
venv/

# Ignore zip files
*.zip

# Ignore logs
*.log

# Ignore runtime files
radio_ps/**/favorites.json
radio_ps/**/recent.json
radio_ps/**/session.json
radio_ps/**/stats.json
radio_ps/**/radio_log.txt